# Project build, install, and release outputs (including separate Debug trees).
/build/
/build-*/
/build_*/
/cmake-build*/
# Release packages, ZIPs, NSIS scripts/payloads, wrappers, and build logs.
/dist/
/install/
/out/

# CMake/CTest generated files, including accidental in-source builds.
# Keep hand-written *.cmake modules and shared CMakePresets.json trackable.
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
CPackConfig.cmake
CPackSourceConfig.cmake
DartConfiguration.tcl
install_manifest*.txt
compile_commands.json
Makefile
Makefile.*
build.ninja
rules.ninja
.ninja_deps
.ninja_log
.cmake/
Testing/
_CPack_Packages/
CMakeUserPresets.json
CMakeSettings.json

# Qt-generated code and Qt Creator per-user state.
*_autogen/
.qt/
moc_*.cpp
qrc_*.cpp
ui_*.h
*.pro.user*
CMakeLists.txt.user*

# Test previews outside a build directory. Published docs/images stay tracked.
/previews/
/previews-*/

# Local app preferences and QSettings lock/backup files; keep fixtures trackable.
/settings.ini
/settings.ini.*
/powerpatch_settings_backup.ini

# IDE workspaces, generated Visual Studio projects, and configuration outputs.
.vs/
.vscode/
*.code-workspace
ipch/
/x64/
/x86/
/Win32/
/Debug/
/Release/
/RelWithDebInfo/
/MinSizeRel/
*.sln
*.slnx
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.user
*.suo
*.ncb
*.aps
*.opendb
*.sdf
*.VC.db
*.VC.db-shm
*.VC.db-wal
*.VC.VC.opendb

# Compiled binaries, symbols, compiler/linker intermediates, and crash dumps.
*.exe
*.dll
*.lib
*.exp
*.obj
*.obj.d
*.o
*.res
*.pdb
*.ilk
*.pch
*.idb
*.ipdb
*.iobj
*.tlog
*.rsp
*.dmp

# Local logs, caches, and temporary editor files.
*.log
.cache/
__pycache__/
*.py[cod]
.venv/
*.tmp
*.temp
*.swp
*.swo
*~

# OS metadata.
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
